# Copy to .env and adjust. Never commit .env.

# Deployment environment: local, staging or production.
ENV=local
# HTTP port the API listens on.
PORT=8080
# Log level: debug, info, warn or error.
LOG_LEVEL=info

# PostgreSQL connection string (local compose database by default).
DATABASE_URL=postgres://sport:sport@localhost:5432/sport_challenge?sslmode=disable

# Auth0 tenant host name, without scheme (see docs/auth0-setup.md).
AUTH0_DOMAIN=sport-challenge-dev.ca.auth0.com
# Identifier of the Auth0 API: the audience of the access tokens.
AUTH0_AUDIENCE=https://api.dev.sport-challenge
