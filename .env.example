# Copy to .env and adjust. Never commit .env.

# Deployment environment: local or production.
ENV=local
# HTTP port the API listens on.
PORT=8080
# Log level: debug, info, warn or error.
LOG_LEVEL=info

# PostgreSQL connection string (local compose database by default).
DATABASE_URL=postgres://sport:sport@localhost:5432/sport_challenge?sslmode=disable
# Maintenance database where integration tests create and drop their own databases.
TEST_DATABASE_URL=postgres://sport:sport@localhost:5432/postgres?sslmode=disable

# Auth0 tenant host name, without scheme (see docs/auth0-setup.md).
AUTH0_DOMAIN=sport-challenge-prod.ca.auth0.com
# Identifier of the Auth0 API: the audience of the access tokens.
AUTH0_AUDIENCE=https://api.sport-challenge

# Auth0 Management API (machine-to-machine application): deletes the account
# at Auth0 when a user deletes theirs. Required.
AUTH0_MGMT_CLIENT_ID=

AUTH0_MGMT_CLIENT_SECRET=

# Domaine du tenant pour l'API de gestion d'Auth0 (suppression de compte).
# Optionnel : à régler seulement avec un domaine personnalisé ; vaut AUTH0_DOMAIN par défaut.
# AUTH0_MGMT_DOMAIN=

# Web origins allowed to call the API from a browser, comma-separated
# (scheme://host[:port]), never *. Empty: no browser origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Proxies in front of the API (IP addresses or CIDR ranges, comma-separated):
# only their X-Forwarded-For is read to find the client IP. Required outside
# ENV=local (Cloud Run); empty locally.
TRUSTED_PROXIES=

RATE_LIMIT_IP_RPS=20
RATE_LIMIT_IP_BURST=40
RATE_LIMIT_USER_RPS=2
RATE_LIMIT_USER_BURST=10

# Moves the clock forward (ENV=local only), to see a week end in minutes,
# e.g. 168h. Empty: real time.
CLOCK_OFFSET=

# How long before the end of a week a participant under the minimum of the
# elimination category is "at risk". Default 24h.
AT_RISK_THRESHOLD=24h