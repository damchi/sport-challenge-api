# Copy to .env and adjust. Never commit .env.

# Deployment environment: local, staging or production.
ENV=local
# HTTP port the API listens on.
PORT=8080
# Log level: debug, info, warn or error.
LOG_LEVEL=info

# PostgreSQL connection string (local compose database by default).
DATABASE_URL=postgres://sport:sport@localhost:5432/sport_challenge?sslmode=disable
