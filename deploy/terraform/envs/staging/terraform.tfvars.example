# Copy to terraform.tfvars (ignored by git) and fill in.
project_id           = "sport-challenge-staging"
billing_account_id   = "XXXXXX-XXXXXX-XXXXXX"
budget_amount        = 0 # monthly, whole units
budget_currency_code = "CAD" # the currency of the billing account
budget_alert_email   = "you@example.com"

# <image_repository output>/api:<tag>, pushed before the first apply
image                = "northamerica-northeast1-docker.pkg.dev/sport-challenge-staging/sport-challenge/api:TAG"
auth0_domain         = "sport-challenge-staging.ca.auth0.com"
auth0_audience       = "https://api.example.com"
auth0_mgmt_client_id = "..."
cors_allowed_origins = ["https://app.example.com"]
# The peer address Cloud Run shows to the container, to check on staging before relying on it.
trusted_proxies      = ["169.254.0.0/16"]
