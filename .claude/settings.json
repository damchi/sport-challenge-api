{
  "extraKnownMarketplaces": {
    "damchi": {
      "source": {
        "source": "github",
        "repo": "damchi/claude-library"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "dev-workflow@damchi": true,
    "backend-review@damchi": true
  },
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go mod tidy)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(make test)",
      "Bash(make test-integration)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make generate)",
      "Bash(make migrate-up)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)",
      "Bash(git pull --ff-only)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(ticket config)",
      "Bash(ticket size)",
      "Bash(ticket new:*)",
      "Bash(ticket next)",
      "Bash(ticket start:*)",
      "Bash(ticket tick:*)",
      "Bash(ticket add:*)",
      "Bash(ticket cleanup:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)",
      "Bash(gh project item-add:*)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git reset:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push:* main*)",
      "Bash(git push:*:main*)",
      "Bash(git push:* master*)",
      "Bash(git push:*:master*)",
      "Bash(git push:*--delete*)",
      "Bash(git push:* -d *)",
      "Bash(git push:* :*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git worktree remove:*)",
      "Bash(git am:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh repo delete:*)",
      "Bash(git reset:*--hard*)",
      "Bash(git push:* +*)",
      "Bash(git push:* -f*)",
      "Bash(git push:*--force*)",
      "Bash(git push:*--no-verify*)",
      "Bash(git commit:*--no-verify*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(gcloud run deploy:*)"
    ]
  }
}
