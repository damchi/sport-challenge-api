{
  "ticket_prefix": "SC-API",
  "project": "Sport Challenge",
  "auto_pr": true,
  "checks": [
    { "run": "make fmt && make lint && make test" },
    { "run": "make test-integration", "when": "le ticket touche au SQL, à un repository ou aux migrations" },
    { "run": "make migrate-up && make migrate-down && make migrate-up", "when": "le ticket ajoute une migration (base locale démarrée avec make docker-up)" },
    { "run": "make openapi-lint && make generate", "when": "le ticket modifie api/openapi.yaml (le code régénéré part dans le même commit)" }
  ],
  "reviews": [
    { "agent": "backend-review:go-reviewer", "paths": ["**/*.go"] },
    { "agent": "backend-review:migration-reviewer", "paths": ["migrations/**"] },
    { "agent": "backend-review:security-reviewer", "paths": ["internal/*/handler.go", "internal/*/policy.go", "internal/platform/auth/**", "api/openapi.yaml"] },
    { "agent": "backend-review:openapi-contract-reviewer", "paths": ["api/openapi.yaml"] },
    { "agent": "backend-review:sql-query-reviewer", "paths": ["internal/*/repository.go"] },
    { "agent": "dev-workflow:spec-guardian", "paths": ["internal/scoring/**", "internal/*/rules.go", "internal/*/service.go"] },
    { "agent": "dev-workflow:rules-tester", "paths": ["internal/scoring/**", "internal/*/rules.go"] },
    { "agent": "closure-reviewer", "paths": ["internal/scoring/window.go", "internal/closure/**", "internal/activity/repository.go", "internal/activity/policy.go", "internal/admin/corrections.go", "internal/admin/repository.go", "internal/platform/db/weeklock.go", "cmd/worker/**"] }
  ],
  "rules": ["README.md §2"],
  "pr_size": { "max_lines": 200 }
}